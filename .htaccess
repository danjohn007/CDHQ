Options -Indexes
RewriteEngine On

# Allow direct access to existing files and directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route everything through index.php (relative path: always resolves to the
# directory where this .htaccess lives, regardless of subdirectory install)
RewriteRule ^ index.php [QSA,L]
